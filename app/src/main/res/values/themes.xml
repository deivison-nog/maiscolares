<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal — Material Components Ocean Blue -->
    <style name="Theme.PortalInterativoColares" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Cor primária -->
        <item name="colorPrimary">@color/ocean_700</item>
        <item name="colorPrimaryVariant">@color/ocean_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Cor secundária -->
        <item name="colorSecondary">@color/ocean_400</item>
        <item name="colorSecondaryVariant">@color/ocean_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Fundo e superfície -->
        <item name="android:colorBackground">@color/surface_variant</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/ocean_800</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>