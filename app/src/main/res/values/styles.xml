<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo para itens de ListView -->
    <style name="ListViewItemStyle" parent="@android:style/TextAppearance.Small">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <string name="open_drawer">Abrir Menu</string>
    <string name="close_drawer">Fechar Menu</string>

    <!-- Tema da MainActivity com Toolbar personalizada -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/ocean_700</item>
        <item name="colorPrimaryVariant">@color/ocean_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ocean_400</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/surface_variant</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/ocean_800</item>
    </style>

    <!-- Estilo da Toolbar -->
    <style name="AppToolbarStyle" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/ocean_700</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/ocean_100</item>
    </style>

    <!-- Botão primário moderno -->
    <style name="AppButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/ocean_700</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- AlertDialog personalizado -->
    <style name="AlertDialogCustom" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/ocean_700</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppButtonStyle</item>
    </style>

</resources>
