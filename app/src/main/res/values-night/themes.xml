<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema escuro — Ocean Night -->
    <style name="Theme.PortalInterativoColares" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Cor primária (mais clara no dark mode para contraste) -->
        <item name="colorPrimary">@color/ocean_200</item>
        <item name="colorPrimaryVariant">@color/ocean_300</item>
        <item name="colorOnPrimary">@color/ocean_900</item>
        <!-- Cor secundária -->
        <item name="colorSecondary">@color/ocean_300</item>
        <item name="colorSecondaryVariant">@color/ocean_400</item>
        <item name="colorOnSecondary">@color/ocean_900</item>
        <!-- Fundo e superfície -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnBackground">@color/dark_text_primary</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>