<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant"
    tools:context=".About">

    <!-- Cabeçalho gradiente -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/nav_header_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iconAbout"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/appmaiscolaresnobg" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/www"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBg">

        <TextView
            android:id="@+id/textAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="6dp"
            android:padding="20dp"
            android:text="O aplicativo '+ Colares' é um inovador guia turístico e cultural, desenvolvido pela Info85, que aproveita a intrigante associação de Colares com OVNIs para revelar as inúmeras maravilhas que essa cidade possui. O projeto visa apresentar Colares como um destino diverso e empolgante, onde os visitantes podem explorar uma rica variedade de atrações"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </ScrollView>

    <TextView
        android:id="@+id/www"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ocean_700"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="www.info85.com.br"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>